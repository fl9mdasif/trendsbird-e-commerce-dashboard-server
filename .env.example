DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
ACCESS_JWT_SECRET=your-access-secret-min-32-chars
REFRESH_JWT_SECRET=your-refresh-secret-min-32-chars
ACCESS_JWT_EXPIRES=15m
REFRESH_JWT_EXPIRES=7d
BCRYPT_ROUNDS=12
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=media
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4
PORT=3001
NODE_ENV=development
